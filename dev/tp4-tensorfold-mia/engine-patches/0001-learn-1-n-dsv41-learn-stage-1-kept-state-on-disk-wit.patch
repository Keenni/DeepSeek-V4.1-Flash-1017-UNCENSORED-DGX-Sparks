+    // ---- --learn: a kept state on disk (this rank's slot part and its extent's compressed rows) ---------------
+
+    /// A learned state's file on this rank: `dir/<key:016x>.r<rank>.bin` (every rank writes its own part).
+    fn learnedPath(buf: []u8, dir: []const u8, key: u64, rank: u32) ![:0]const u8 {
