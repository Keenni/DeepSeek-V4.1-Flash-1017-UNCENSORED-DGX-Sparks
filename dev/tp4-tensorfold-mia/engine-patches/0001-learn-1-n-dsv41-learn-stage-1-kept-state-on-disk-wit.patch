+
+    const learned_magic: u32 = 0x44534c31; // "DSL1"
+    const learned_version: u32 = 1;
+
+    /// The layout a read must match (a pool, window, stream count or rank change moves the rows: the file is refused).
+    fn learnedHeader(m: *const Model, at: usize, slot_bytes: usize, extent_bytes: usize) [16]u32 {
+        const pool: u64 = m.pool_cap;
+        return .{
+            learned_magic,       learned_version,                    m.rank,  model.chunk_rows,
