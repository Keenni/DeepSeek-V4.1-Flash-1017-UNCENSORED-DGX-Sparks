diff --git a/zig/src/families/dsv41/model.zig b/zig/src/families/dsv41/model.zig
index 90ae861..a561557 100644
--- a/zig/src/families/dsv41/model.zig
+++ b/zig/src/families/dsv41/model.zig
@@ -684,6 +684,56 @@ pub const Model = struct {
         }
     }
 
+    /// The compressed rows of one extent's positions `[0, at)`: what --learn writes beside the slot state (the plane
+    /// itself stays in the stream's extent; a kept state only holds it back from placement).
+    pub fn extentBytes(m: *const Model, at: usize) usize {
+        const c = m.eng.c;
+        var n: usize = 0;
+        for (m.eng.w.layers) |lay| {
+            if (lay.comp_wkv == null) continue;
+            const r: usize = lay.ratio;
+            if (r == 0 or at % r != 0) return 0;
+            const rows = at / r;
+            n += rows * (c.head_dim / 2) + rows * (c.head_dim / 16);
+            if (lay.idx_wk != null) n += rows * (c.index_head_dim / 2) + rows * (c.index_head_dim / 32);
+        }
+        return n;
+    }
+
+    /// Extent `base`'s compressed rows of positions `[0, at)` to `host` (save: true) or back from it (--learn).
+    pub fn extentCopy(m: *Model, base: usize, at: usize, host: [*]u8, save: bool) !void {
+        const c = m.eng.c;
+        const cs = &m.caches;
+        var off: usize = 0;
+        for (m.eng.w.layers, 0..) |lay, i| {
+            if (lay.comp_wkv == null) continue;
+            const r: usize = lay.ratio;
+            if (base % r != 0 or at % r != 0) return error.BadView;
+            const rows = at / r;
+            try m.copyHost(cs.comp_codes[i] + (base / r) * (c.head_dim / 2), host + off, rows * (c.head_dim / 2), save);
+            off += rows * (c.head_dim / 2);
+            try m.copyHost(cs.comp_scales[i] + (base / r) * (c.head_dim / 16), host + off, rows * (c.head_dim / 16), save);
+            off += rows * (c.head_dim / 16);
+            if (lay.idx_wk != null) {
+                try m.copyHost(cs.idx_codes[i] + (base / r) * (c.index_head_dim / 2), host + off, rows * (c.index_head_dim / 2), save);
+                off += rows * (c.index_head_dim / 2);
+                try m.copyHost(cs.idx_scales[i] + (base / r) * (c.index_head_dim / 32), host + off, rows * (c.index_head_dim / 32), save);
+                off += rows * (c.index_head_dim / 32);
+            }
+        }
+    }
+
+    /// A plane's `bytes` at `dev` to `host` (save) or back, synchronously: a learned state's file copy.
+    fn copyHost(m: *Model, dev: u64, host: [*]u8, bytes: usize, save: bool) !void {
+        if (bytes == 0) return;
+        const d = m.ctx.d;
+        if (save) {
+            try d.check(d.api.cuMemcpyDtoH_v2(host, dev, bytes), "cuMemcpyDtoH");
+        } else {
+            try d.check(d.api.cuMemcpyHtoD_v2(dev, host, bytes), "cuMemcpyHtoD");
+        }
+    }
+
     /// The compressed rows of positions [0, at) of the extent at `from` copied into the extent at `to` (a kept prompt
     /// resumed in another extent while a live stream holds its own), in the stream's order: every kv-source layer's
     /// codes and scales and its index keys, the rows view() places at those positions.
