+
+    /// A learned file: its header, its payload, and the payload's SHA-256 (a torn or foreign file is refused whole).
+    fn learnedWrite(path: [:0]const u8, header: [16]u32, payload: []const u8) !void {
+        const fd = std.c.open(path, .{ .ACCMODE = .WRONLY, .CREAT = true, .TRUNC = true }, @as(std.c.mode_t, 0o600));
+        if (fd < 0) return error.LearnedWrite;
+        defer _ = std.c.close(fd);
+        try writeAll(fd, std.mem.sliceAsBytes(header[0..]));
+        try writeAll(fd, payload);
+        var hash: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(payload, &hash, .{});
+        try writeAll(fd, &hash);
+        if (std.c.fsync(fd) != 0) return error.LearnedWrite;
+    }
+
+    fn learnedRead(path: [:0]const u8, want: [16]u32, payload: []u8) !void {
+        const fd = std.c.open(path, .{ .ACCMODE = .RDONLY }, @as(std.c.mode_t, 0));
+        if (fd < 0) return error.LearnedRead;
+        defer _ = std.c.close(fd);
+        const total: isize = @intCast(16 * 4 + payload.len + 32);
+        _ = std.c.lseek(fd, 0, std.c.SEEK.SET);
+        if (std.c.lseek(fd, 0, std.c.SEEK.END) != total) return error.LearnedRead;
+        var header: [16]u32 = undefined;
+        if (!preadAll(fd, std.mem.sliceAsBytes(header[0..]), 0)) return error.LearnedRead;
+        if (!std.mem.eql(u32, header[0..], want[0..])) return error.LearnedRead;
+        if (!preadAll(fd, payload, 64)) return error.LearnedRead;
+        var stored: [32]u8 = undefined;
+        if (!preadAll(fd, &stored, 64 + payload.len)) return error.LearnedRead;
+        var hash: [32]u8 = undefined;
+        std.crypto.hash.sha2.Sha256.hash(payload, &hash, .{});
+        if (!std.mem.eql(u8, &stored, &hash)) return error.LearnedRead;
+    }
