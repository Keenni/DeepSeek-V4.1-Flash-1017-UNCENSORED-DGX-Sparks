# ============================================================================
# .env.tp4 — v2（knapcio TP4 production line，MiaAI-Lab 225ad3c 基础）
# 老配置备份：.env.tp4.old（fba4470 基线，回退用）
# 本集群习惯保留：端口 8000 / served 名 uncensored / 平铺权重本地直挂 / HiCache /
#   patched NCCL LD_PRELOAD + EP_SUPPRESS / cgroup 112g / Engram 目录 / state-rN
# 性能项对齐 docs/tp4.md production line：EP1 / MRR16 / chunk4096 / 8M pin /
#   mem 0.80 / b12x_next / RoCEnante(ring) / 全套 decode adapters / fast-load
# ============================================================================

HEAD_HOST=dgx03
HEAD_IP=192.168.89.103
WORKER_IPS="192.168.89.104 192.168.89.101 192.168.89.102"
WORKER_HOSTS="dgx04 dgx01 dgx02"
WORKER_USER=root
DEPLOY_DIR=/root/dsv41-tp4

# ── NCCL：沿用本集群 patched 2.30.7 switchless（GLM 同款），双 HCA 聚合铁律 ──
IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
NCCL_SHM_DISABLE=1
NCCL_IB_ADDR_RANGE=10.0.0.0/22
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
NCCL_IB_GID_INDEX=3
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_CUMEM_ENABLE=0
NCCL_ALGO=Ring
# 上游实测：4MiB Simple + 4.69MiB LL128 × 512 连接 = 4.7GiB pinned/节点；
# decode all-reduce 61KB 走 LL，LL128 无收益 → buffsize 1MiB + 排除 LL128（0.14GB）
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG=INFO
NCCL_DEBUG_SUBSYS=INIT,ENV
NCCL_HOST_DIR=/root/nccl-switchless
NCCL_CONTAINER_DIR=/nccl
NCCL_SKIP_TREE_CONNECT=1
NCCL_SWITCHLESS_RING_ONLY=1
# v2 产线镜像构建目标（Dockerfile.canary-roce；构建期需 github/pypi，见 build）
BUILD_DOCKERFILE=Dockerfile.canary-roce
BUILD_ARGS=

# ── 模型 / 镜像（本集群习惯：平铺权重四台本地、UNCENSORED）──────────────────
MODEL_DIR=/models/DeepSeek-V4.1-Flash-1017-heretic
ENGRAM_DIR=/models/dsv41-uncensored-engram
MODEL_IN_CONTAINER=/models/DeepSeek-V4.1-Flash-1017-heretic
# 首次切 v2 用旧 overlay 镜像也能起（EXTRA_CONTAINER_ENV 里 TP4-only 开关关掉时
# 行为≈v1）；切产线时改成 canary-roce 并 build（见 build 时注释）。
BASE_IMAGE=lmsysorg/sglang:dev-dsv41
IMAGE=dsv41-4x-spark:canary-roce
PORT=8000
SERVED_MODEL_NAME=deepseek-v4.1-flash-uncensored

# ── 脚本引用的变量（v1 已有；v2 首版漏抄 → set -u 下 worker 起不来）──────────
API_KEY=
DSV41_PACKED_DIR=/engram
DSV41_RESIDENT_SCALES=0
DSV41_TP_PAD=0
DSV41_MXFP8_BACKEND=b12x
DSV41_SHARED_PAD_K=1
DSV41_SHARED_PAD_BUF_ROWS=256
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
SGLANG_ENABLE_DSV41_ENGRAM_HOST_TABLE=0
NCCL_P2P_DISABLE=0

# ── 并行 ──
NNODES=4
TP_SIZE=4
# 产线=1（每 rank 持全部 384 expert 的 576 宽切片，路由 MoE 走 b12x_next；
# MoE all-reduce 5.9→2.6ms）。注意：EP1 要求 canary-roce 镜像 + DSV41_MOE_B12X_NEXT=1。
EP_SIZE=1
DIST_PORT=25000

# ── serving（对齐上游 tp4 profile 实测值）
#   2026-10-06 用户指令：KV cache 不落 NVMe——EXTRA_SGLANG_ARGS 里整组 HiCache 已摘除
#   （--enable-hierarchical-cache / --hicache-host-memory-mode cache / --hicache-storage-backend file /
#    --hicache-ratio 0.18）。要恢复就把这几个 flag 加回去。────────────────────────────────────
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=4
DSV41_CACHE_WAYS=16
DSV41_IO_THREADS=96
DSV41_STATS_SECONDS=60
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.85
HEAD_MEM_FRACTION_STATIC=0.85
MAX_RUNNING_REQUESTS=16
# 4096 依赖 DSV41_INDEXER_CHUNKED=1（EXTRA_CONTAINER_ENV），瞬态被限在 ≤2GiB 行块
CHUNKED_PREFILL_SIZE=4096
# 上游 TP4 pin=8M（0.80 fraction 下 profiled 更高，无告警）；1M needle 实测通过
MAX_TOTAL_TOKENS=8000000
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json
CUDA_DEVICE_ORDER=PCI_BUS_ID
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False

# 上游 tp4 profile 的 serve args（+ 我们的 HiCache/swa-tails 保留项）
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --swa-prefix-tails 160"

# ── HiCache（本集群方案保留：rank0 写盘 + NFS 共享）──────────────────────────
# ── HiCache：关闭（2026-10-20 定稿）──────────────────────────────────────────
#   HICACHE_ENABLE=0 → start 脚本跳过 hicache NFS 共享；容器规格里也不再挂 /hicache。
#   ⚠️ 只删 flag 不够：worker 上 /root/dsv41-hicache 是残留 NFS 挂载点，docker 会报
#      "error while creating mount source path '/root/dsv41-hicache': mkdir ...: file exists"
#      → 容器卡在 created（pid=0）永不 running，四台 worker 全起不来。
#   冷启标定（2026-10-20 05:18，frac=0.85、HiCache off、权重=1017-heretic）：
#      full=6,781,184 tok｜swa=88,576｜c4=1,695,296｜c128=52,978｜c4_state=11,072
#      池外 avail=18.01 GB｜boot 后 available_gpu_mem=7.29 GB｜Engram packed=True 命中 82.5%
#      对比 2026-09-26（同 frac + HiCache ratio 0.18）：full 只有 3,930,368、池外 14.14 GB
#   注：MAX_TOTAL_TOKENS=8000000 高于 profiled → boot 会告警并按 6,781,184 回退（装饰值）。
HICACHE_ENABLE=0
HICACHE_HOST_DIR=/root/dsv41-hicache
SGLANG_HICACHE_FILE_BACKEND_MAX_SIZE=800G
SGLANG_DSPARK_ENABLE_SPS_RECORD=1
SGLANG_RAGGED_VERIFY_MODE=static

SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=1
WARMUP=1
READY_TIMEOUT_S=3600

CACHE_HOST_DIR=/root/.cache/huggingface
CACHE_CONTAINER_DIR=/cache/huggingface
TRITON_CACHE_DIR=/cache/huggingface/triton
FLASHINFER_WORKSPACE_BASE=/cache/huggingface
HF_HOME=/cache/huggingface
CONTAINER_MEMORY=112g
SHM_SIZE=64g

# ── house adapter（我们自己的 dynamic_chunk 保留可选；上游新线由
#    DSV41_INDEXER_CHUNKED 接管瞬态，此 hook 与 4096 静态值共存无害）──────────
DSV41_CHUNK_BUDGET=0
DSV41_CHUNK_MAX=4096
DSV41_CHUNK_MIN=256

# ── TP4 production EXTRA_CONTAINER_ENV ────────────────────────────────────────
# ⚠️ 我们是 switchless ring（无 RoCE 交换机）。上游实测（tp4-switchless-ring-results.md，
#    同为无交换机四机环）产线跑法 = 全部 decode/prefill adapters + 传输走 patched NCCL；
#    RoCEnante one-shot all-reduce 在 ring 上是 research-only（需 sparkring 硬件转发
#    opposite-node 路径 + plan.py 生成 peer maps），默认不开。
#    ⇒ 默认档 C：canary-roce 镜像（要它的 dsv4.1 分支树 + b12x_next + SP/HC adapters），
#      SGLANG_ROCE_ALLREDUCE=0、无 DSV41_ROCE_GATHER。等 plan.py 路线验证后再升 D 档。
# C) ring 产线档（当前默认）
EXTRA_CONTAINER_ENV="DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_RUST_BUILD_MODE=never DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_ENGRAM_PREFETCH=1 DSV41_SHARED_PAD_K=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1 DSV41_DRAFT_HEAD_FP8_IMPL=tp4 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1"
# D) 交换机全量档（有 RoCE 交换机时；或 ring 上验证 sparkring 硬件转发后）：
#   在 C 的基础上追加 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=2097152 DSV41_ROCE_GATHER=2097152
#   B12X_ROCE_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1 B12X_ROCE_PEER_HCA_MAPS=<plan.py 输出>
#   B12X_ROCE_TWO_WAVE_THRESHOLD_BYTES=0 B12X_ROCE_CACHE_DIR=/state/b12x-roce B12X_COMPILE_CACHE_DIR=/state/b12x-compile
#   DSV41_ROCE_RING=1（ring 变体；MAX_SIZE/GATHER 用 262144 且需 hairpin_queue_size 8192）
